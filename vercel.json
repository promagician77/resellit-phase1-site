{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'prebuilt static site: nothing to install'",
  "buildCommand": "echo 'prebuilt static site: site/ is committed'",
  "outputDirectory": "site",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/market/poshmark/listing/:id*",
      "destination": "/market/_listing/index.html"
    },
    {
      "source": "/market/mercari/item/:id*",
      "destination": "/market/_listing/index.html"
    },
    {
      "source": "/market/depop/products/:id*",
      "destination": "/market/_listing/index.html"
    },
    {
      "source": "/market/vinted/items/:id*",
      "destination": "/market/_listing/index.html"
    },
    {
      "source": "/market/facebook/marketplace/item/:id*",
      "destination": "/market/_listing/index.html"
    },
    {
      "source": "/market/ebay/itm/:id*",
      "destination": "/market/_listing/index.html"
    },
    {
      "source": "/market/:m/closet",
      "destination": "/market/_listing/index.html"
    },
    {
      "source": "/market/:m/closet/",
      "destination": "/market/_listing/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/(fonts|photos)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}